<mujoco model="robot">
    <compiler angle="radian" meshdir="meshes/" eulerseq="zyx"/>
    <option timestep='0.001' iterations='50' solver='Newton' gravity='0 0 -9.81' integrator = 'RK4'>
        <!-- <flag sensornoise="enable" frictionloss="enable"/> -->
    </option>
    <size njmax="500" nconmax="100" />

    <visual>
        <quality shadowsize='4096'/>
        <map znear='0.05'/>
    </visual>

    <default>
        <joint limited='true'/>
        <motor ctrllimited='true'/>
        <geom  condim='3' contype="1" conaffinity="15" solref='0.02 1' friction='0.9 0.9 0.9'/>
        <equality solref='0.02 1'/>
        <default class='visualgeom'>
            <geom material='visualgeom' condim='1' contype='0' conaffinity='0'/>
        </default>
        <default class='visualgeom2'>
            <geom material='visualgeom2' condim='1' contype='0' conaffinity='0'/>
        </default>
        <default class='obstacle'>
            <geom material='obstacle' condim='3' contype='1' conaffinity='15'/>
        </default>
        <default class='contact'>
            <geom material='contact' condim='3' contype='1' conaffinity='15'/>
        </default>
      
        <default class='leg_joint_param'>
            <joint  damping="0.01" frictionloss="0.01" armature="0.01"/>
        </default>

    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2"
            width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>
        <texture name="texplane2" type="2d" builtin="checker" rgb1="1 0.3137 0.1843" rgb2="0.0 0.30196 0.38039"
            width="512" height="512" mark="cross" markrgb=".8 .8 .8"/>

        <material name="matplane" reflectance="0." texture="texplane" texrepeat="1 1" texuniform="true"/>
        <material name="matplane2" reflectance="0.1" texture="texplane2" texrepeat="1 1" texuniform="true"/>

        <material name='obstacle'  rgba='0.9 0.6 0.2 1'/>
        <material name='visualgeom'  rgba='0.5 0.9 0.2 1'/>
        <material name='visualgeom2'  rgba='0.5 0.9 0.2 1'/>
        <material name='contact'  rgba='0.5 0.9 0.2 1'/>

        <mesh name="base_link" file="base_link.STL" />
        <mesh name="RF-hip-link" file="RF-hip-link.STL" />
        <mesh name="RF-thigh-link" file="RF-thigh-link.STL" />
        <mesh name="RF-calf-link" file="RF-calf-link.STL" />
        <mesh name="LF-hip-link" file="LF-hip-link.STL" />
        <mesh name="LF-thigh-link" file="LF-thigh-link.STL" />
        <mesh name="LF-calf-link" file="LF-calf-link.STL" />
        <mesh name="RB-hip-link" file="RB-hip-link.STL" />
        <mesh name="RB-thigh-link" file="RB-thigh-link.STL" />
        <mesh name="RB-calf-link" file="RB-calf-link.STL" />
        <mesh name="LB-hip-link" file="LB-hip-link.STL" />
        <mesh name="LB-thigh-link" file="LB-thigh-link.STL" />
        <mesh name="LB-calf-link" file="LB-calf-link.STL" />
                <material name="white" rgba="1 1 1 1" />
        <material name="red" rgba="1 0 0 1" />
		<material name="gold" rgba="1 0.843 0 1" />
		<material name="orange" rgba="1 0.550 0 1" />
		<material name="blue" rgba="0 0 1 1" />
        <material name="grey" rgba="0.5 0.5 0.5 1" />
        <material name="yellow" rgba="1 1 0 1" />
        <material name="pink" rgba="0 1 1 1" />
        <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.2 0.3 0.4" rgb2="0 0 0" width="1000" height="1000" mark="random" random="0.001" markrgb="1 1 1"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="1000" height="1000"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

        <hfield name='hf0' nrow='200' ncol='200' size="10 5 0.2 .1"/>
    </asset>
    <worldbody>
        <!-- Add a light-->
        <light pos="0 0 10" dir="0 0 -1" directional="true"/>
        <light name="spotlight" mode="targetbodycom" target="base_link" pos="0 -1 2"/>
        <!-- Add a floor-->
        <geom name="ground" type="plane" size="0 0 1" pos="0.001 0 0" quat="1 0 0 0" material="groundplane" condim="1" conaffinity='15'/>
        <!-- Handwrite 控制身体系原点离地的高度 1.50 -->
        <body name="base_link" pos="0 0 1.00">
            <camera name="track" pos="0 -3 1" zaxis="0 -1 0.5" mode="track"/>
            <!-- Handwrite 需要修改-->
            <inertial pos="0.002148 -0.000388 -0.103293" mass="119.277" diaginertia="6.637751 2.408774e+01 2.883469e+01"/>
            <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.54902 0.0470588 0.0431373 1" mesh="base_link" />
            <site name="imu" size="0.01" pos="0 0 0"/>
            <!-- <freejoint/> is important！ -->
            <freejoint/>
            <body name="FL_hip" pos="0.641 0.309 -0.097">
                <inertial pos="-0.1702 -0.000782 -0.08772" quat="0.478493 0.525482 0.506642 0.488085" mass="12.36" diaginertia="0.227309 0.212019 0.0368831" />
                <!-- <joint name="FL_hip_joint" pos="0 0 0" axis="1 0 0" limited="true" range="-0.349 0.349" class="leg_joint_param"/> -->
                <joint name="FL_hip_joint" pos="0 0 0" axis="1 0 0" limited="true" range="-0.24 0.24" class="leg_joint_param"/>
                <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.94902 0.752941 0.337255 1" mesh="LF-hip-link" class="visualgeom"/>
                <body name="FL_thigh" pos="0 0 -0.1065">
                    <inertial pos="0.01379 2.4e-05 -0.3409" quat="0.705446 0.0142639 0.0141537 0.708479" mass="11.479" diaginertia="0.366903 0.364549 0.0300901" />
                    <joint name="FL_thigh_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-1.0472 1.22173" class="leg_joint_param"/>
                    <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.94902 0.752941 0.337255 1" mesh="LF-thigh-link" class="visualgeom"/>
                    <!-- <geom size="0.25 0.02 0.02" pos="0 0 -0.27" quat="0.707107 0 0.707107 0" type="box" rgba="0.94902 0.752941 0.337255 1" /> -->
                    <body name="FL_calf" pos="0 0 -0.55">
                        <inertial pos="-0.0471514 -2.97273e-06 -0.286401" quat="0.999304 7.77721e-06 0.0373149 -0.000137841" mass="4.9601" diaginertia="0.17825 0.176816 0.00989609" />
                        <joint name="FL_calf_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-2.79253 -0.0174533" class="leg_joint_param"/>
                        <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.54902 0.0470588 0.0431373 1" mesh="LF-calf-link" class="contact"/>
                        <geom size="0.050" pos="-0.08 0 -0.4936" material="blue" />
                    </body>
                </body>
            </body>
            <body name="FR_hip" pos="0.641 -0.309 -0.097">
                <inertial pos="-0.170224 0.000828 -0.087717" quat="0.488296 0.506492 0.525626 0.478278" mass="12.36" diaginertia="0.227309 0.212018 0.0368827" />
                <!-- <joint name="FR_hip_joint" pos="0 0 0" axis="1 0 0" limited="true" range="-0.349 0.349" class="leg_joint_param"/> -->
                <joint name="FR_hip_joint" pos="0 0 0" axis="-1 0 0" limited="true" range="-0.24 0.24" class="leg_joint_param"/>
                <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.94902 0.752941 0.337255 1" mesh="RF-hip-link" class="visualgeom"/>
                <body name="FR_thigh" pos="0 0 -0.1065">
                    <inertial pos="0.01379 2.4e-05 -0.3409" quat="0.705446 0.0142639 0.0141537 0.708479" mass="11.479" diaginertia="0.366903 0.364549 0.0300901" />
                    <joint name="FR_thigh_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-1.0472 1.22173" class="leg_joint_param"/>
                    <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.94902 0.752941 0.337255 1" mesh="RF-thigh-link" class="visualgeom"/>
                    <!-- <geom size="0.25 0.02 0.02" pos="0 0 -0.27" quat="0.707107 0 0.707107 0" type="box" rgba="0.94902 0.752941 0.337255 1" /> -->
                    <body name="FR_calf" pos="0 0 -0.55">
                        <inertial pos="-0.0471514 -2.97273e-06 -0.286401" quat="0.999304 7.77721e-06 0.0373149 -0.000137841" mass="4.9601" diaginertia="0.17825 0.176816 0.00989609" />
                        <joint name="FR_calf_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-2.79253 -0.0174533" class="leg_joint_param"/>
                        <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.54902 0.0470588 0.0431373 1" mesh="RF-calf-link" class="contact"/>
                        <geom size="0.050" pos="-0.08 0 -0.4936" material="blue" />
                    </body>
                </body>
            </body>
            
            <body name="RL_hip" pos="-0.641 0.309 -0.097">
                <inertial pos="0.1705 -0.000789 -0.09047" quat="0.509454 0.485049 0.476093 0.52775" mass="12.322" diaginertia="0.231304 0.21285 0.0400558" />
                <!-- <joint name="RL_hip_joint" pos="0 0 0" axis="1 0 0" limited="true" range="-0.349 0.349" class="leg_joint_param"/> -->
                <joint name="RL_hip_joint" pos="0 0 0" axis="1 0 0" limited="true" range="-0.24 0.24" class="leg_joint_param"/>
                <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.94902 0.752941 0.337255 1" mesh="LB-hip-link" class="visualgeom"/>
                <body name="RL_thigh" pos="0 0 -0.1065">
                    <inertial pos="-0.005588 3.2e-05 -0.3437" quat="0.705007 -0.0229647 -0.0228499 0.70846" mass="11.048" diaginertia="0.353812 0.352271 0.0270174" />
                    <joint name="RL_thigh_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-1.0472 1.22173" class="leg_joint_param"/>
                    <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.94902 0.752941 0.337255 1" mesh="LB-thigh-link" class="visualgeom"/>
                    <!-- <geom size="0.25 0.02 0.02" pos="0 0 -0.27" quat="0.707107 0 0.707107 0" type="box" rgba="0.94902 0.752941 0.337255 1" /> -->
                    <body name="RL_calf" pos="0 0 -0.55">
                        <inertial pos="-0.0471514 -2.97273e-06 -0.286401" quat="0.999304 7.77721e-06 0.0373149 -0.000137841" mass="4.9601" diaginertia="0.17825 0.176816 0.00989609" />
                        <joint name="RL_calf_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-2.79253 -0.0174533" class="leg_joint_param"/>
                        <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.54902 0.0470588 0.0431373 1" mesh="LB-calf-link" class="contact"/>
                        <geom size="0.050" pos="-0.08 0 -0.4936" material="blue" />
                    </body>
                </body>
            </body>
            <body name="RR_hip" pos="-0.641 -0.309 -0.097">
                <inertial pos="0.1708 0.000691 -0.09055" quat="0.526537 0.476742 0.483836 0.511252" mass="12.3" diaginertia="0.230681 0.212245 0.0399282" />
                <!-- <joint name="RR_hip_joint" pos="0 0 0" axis="1 0 0" limited="true" range="-0.349 0.349" class="leg_joint_param"/> -->
                <joint name="RR_hip_joint" pos="0 0 0" axis="-1 0 0" limited="true" range="-0.24 0.24" class="leg_joint_param"/>
                <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.94902 0.752941 0.337255 1" mesh="RB-hip-link" class="visualgeom"/>
                <body name="RR_thigh" pos="0 0 -0.1065">
                    <inertial pos="-0.005588 3.2e-05 -0.3437" quat="0.705005 -0.022989 -0.0228741 0.708461" mass="11.048" diaginertia="0.353812 0.352273 0.0273609" />
                    <joint name="RR_thigh_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-1.0472 1.22173" class="leg_joint_param"/>
                    <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.94902 0.752941 0.337255 1" mesh="RB-thigh-link" class="visualgeom"/>
                    <!-- <geom size="0.25 0.02 0.02" pos="0 0 -0.27" quat="0.707107 0 0.707107 0" type="box" rgba="0.94902 0.752941 0.337255 1" /> -->
                    <body name="RR_calf" pos="0 0 -0.55">
                        <inertial pos="-0.0471514 -2.97273e-06 -0.286401" quat="0.999304 7.77721e-06 0.0373149 -0.000137841" mass="4.9601" diaginertia="0.17825 0.176816 0.00989609" />
                        <joint name="RR_calf_joint" pos="0 0 0" axis="0 1 0" limited="true" range="-2.79253 -0.0174533" class="leg_joint_param"/>
                        <geom type="mesh" contype="1" conaffinity="0" group="1" density="0" rgba="0.54902 0.0470588 0.0431373 1" mesh="RB-calf-link" class="contact"/>
                        <geom size="0.050" pos="-0.08 0 -0.4936" material="blue" />
                    </body>
                </body>
            </body>
            
        </body>
    </worldbody>

    <actuator>
        <motor name="motor_FL_hip_joint" joint="FL_hip_joint" gear="1" ctrllimited="true" ctrlrange="-100 100" />
        <motor name="motor_FL_thigh_joint" joint="FL_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-350 350" />
        <motor name="motor_FL_calf_joint" joint="FL_calf_joint" gear="1" ctrllimited="true" ctrlrange="-600 600" />

        <motor name="motor_FR_hip_joint" joint="FR_hip_joint" gear="1" ctrllimited="true" ctrlrange="-100 100" />
        <motor name="motor_FR_thigh_joint" joint="FR_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-350 350"  />
        <motor name="motor_FR_calf_joint" joint="FR_calf_joint" gear="1" ctrllimited="true" ctrlrange="-600 600"  />

        <motor name="motor_RL_hip_joint" joint="RL_hip_joint" gear="1" ctrllimited="true" ctrlrange="-100 100"  />
        <motor name="motor_RL_thigh_joint" joint="RL_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-450 450"   />
        <motor name="motor_RL_calf_joint" joint="RL_calf_joint" gear="1" ctrllimited="true" ctrlrange="-570 570"  />

        <motor name="motor_RR_hip_joint" joint="RR_hip_joint" gear="1" ctrllimited="true" ctrlrange="-100 100"   />
        <motor name="motor_RR_thigh_joint" joint="RR_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-450 450"  />
        <motor name="motor_RR_calf_joint" joint="RR_calf_joint" gear="1" ctrllimited="true" ctrlrange="-570 570"  />

        
    </actuator>

    <sensor>
        <actuatorpos name="FL_hip_joint_Pos_p" actuator="motor_FL_hip_joint" user='13'/>
        <actuatorpos name="FL_thigh_joint_Pos_p" actuator="motor_FL_thigh_joint" user='13'/>
        <actuatorpos name="FL_calf_joint_Pos_p" actuator="motor_FL_calf_joint" user='13'/>
        <actuatorpos name="FR_hip_joint_Pos_p" actuator="motor_FR_hip_joint" user='13'/>
        <actuatorpos name="FR_thigh_joint_Pos_p" actuator="motor_FR_thigh_joint" user='13'/>
        <actuatorpos name="FR_calf_joint_Pos_p" actuator="motor_FR_calf_joint" user='13'/>
        <actuatorpos name="RL_hip_joint_Pos_p" actuator="motor_RL_hip_joint" user='13'/>
        <actuatorpos name="RL_thigh_joint_Pos_p" actuator="motor_RL_thigh_joint" user='13'/>
        <actuatorpos name="RL_calf_joint_Pos_p" actuator="motor_RL_calf_joint" user='13'/>
        <actuatorpos name="RR_hip_joint_Pos_p" actuator="motor_RR_hip_joint" user='13'/>
        <actuatorpos name="RR_thigh_joint_Pos_p" actuator="motor_RR_thigh_joint" user='13'/>
        <actuatorpos name="RR_calf_joint_Pos_p" actuator="motor_RR_calf_joint" user='13'/>
        
        <actuatorvel name="FL_hip_joint_Pos_v" actuator="motor_FL_hip_joint" user='13'/>
        <actuatorvel name="FL_thigh_joint_Pos_v" actuator="motor_FL_thigh_joint" user='13'/>
        <actuatorvel name="FL_calf_joint_Pos_v" actuator="motor_FL_calf_joint" user='13'/>
        <actuatorvel name="FR_hip_joint_Pos_v" actuator="motor_FR_hip_joint" user='13'/>
        <actuatorvel name="FR_thigh_joint_Pos_v" actuator="motor_FR_thigh_joint" user='13'/>
        <actuatorvel name="FR_calf_joint_Pos_v" actuator="motor_FR_calf_joint" user='13'/>
        <actuatorvel name="RL_hip_joint_Pos_v" actuator="motor_RL_hip_joint" user='13'/>
        <actuatorvel name="RL_thigh_joint_Pos_v" actuator="motor_RL_thigh_joint" user='13'/>
        <actuatorvel name="RL_calf_joint_Pos_v" actuator="motor_RL_calf_joint" user='13'/>
        <actuatorvel name="RR_hip_joint_Pos_v" actuator="motor_RR_hip_joint" user='13'/>
        <actuatorvel name="RR_thigh_joint_Pos_v" actuator="motor_RR_thigh_joint" user='13'/>
        <actuatorvel name="RR_calf_joint_Pos_v" actuator="motor_RR_calf_joint" user='13'/>
        
        <actuatorfrc name="FL_hip_joint_Pos_f" actuator="motor_FL_hip_joint" user='13'/>
        <actuatorfrc name="FL_thigh_joint_Pos_f" actuator="motor_FL_thigh_joint" user='13'/>
        <actuatorfrc name="FL_calf_joint_Pos_f" actuator="motor_FL_calf_joint" user='13'/>
        <actuatorfrc name="FR_hip_joint_Pos_f" actuator="motor_FR_hip_joint" user='13'/>
        <actuatorfrc name="FR_thigh_joint_Pos_f" actuator="motor_FR_thigh_joint" user='13'/>
        <actuatorfrc name="FR_calf_joint_Pos_f" actuator="motor_FR_calf_joint" user='13'/>
        <actuatorfrc name="RL_hip_joint_Pos_f" actuator="motor_RL_hip_joint" user='13'/>
        <actuatorfrc name="RL_thigh_joint_Pos_f" actuator="motor_RL_thigh_joint" user='13'/>
        <actuatorfrc name="RL_calf_joint_Pos_f" actuator="motor_RL_calf_joint" user='13'/>
        <actuatorfrc name="RR_hip_joint_Pos_f" actuator="motor_RR_hip_joint" user='13'/>
        <actuatorfrc name="RR_thigh_joint_Pos_f" actuator="motor_RR_thigh_joint" user='13'/>
        <actuatorfrc name="RR_calf_joint_Pos_f" actuator="motor_RR_calf_joint" user='13'/>
        

        <framequat     name='orientation' objtype='site' noise='0.001' objname='imu'/>
        <framepos     name='position' objtype='site' noise='0.001' objname='imu'/>
        <gyro          name='angular-velocity'    site='imu' noise='0.005' cutoff='34.9'/>
        <velocimeter   name='linear-velocity'     site='imu' noise='0.001' cutoff='30'/>
        <accelerometer name='linear-acceleration' site='imu' noise='0.005' cutoff='157'/>
        <magnetometer  name='magnetometer'        site='imu'/>
    
    </sensor>
</mujoco>
